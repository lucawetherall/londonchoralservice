{"nodes": [{"id": "docs_superpowers_plans_2026_05_09_nav_services_dropdown", "label": "Nav Services Dropdown Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-05-09-nav-services-dropdown.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_05_09_nav_services_dropdown_nav_services_dropdown", "label": "Nav Services Dropdown Initiative", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-05-09-nav-services-dropdown.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The global nav was cramped at 768-1100px viewport widths, the 'Music Guides' label could wrap to two lines, and the four commercial occasion pages (weddings/funerals/corporate/christmas) were reachable only via services.html, losing internal-link-equity distribution. Fixing cramping alone would leave those pages buried, and surfacing them as new top-level items would worsen cramping, so the two problems had to be solved together via CSS nowrap safety rules plus a Services dropdown."}], "edges": [{"source": "docs_superpowers_plans_2026_05_09_nav_services_dropdown", "target": "docs_superpowers_specs_2026_05_09_nav_services_dropdown_design", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-05-09-nav-services-dropdown.md", "source_location": "Spec: [docs/superpowers/specs/2026-05-09-nav-services-dropdown-design.md]", "weight": 1.0}, {"source": "docs_superpowers_plans_2026_05_09_nav_services_dropdown", "target": "docs_superpowers_plans_2026_05_09_nav_services_dropdown_nav_services_dropdown", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-05-09-nav-services-dropdown.md", "source_location": null, "weight": 1.0}], "hyperedges": []}