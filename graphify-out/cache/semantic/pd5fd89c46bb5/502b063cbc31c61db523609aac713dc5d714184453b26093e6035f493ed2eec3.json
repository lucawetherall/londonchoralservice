{"nodes": [{"id": "docs_superpowers_specs_2026_08_29_international_luxury_weddings_design_spec", "label": "International and destination wedding engagements \u2014 design doc", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-29-international-luxury-weddings-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_29_international_luxury_weddings_design_registerbecomespartial", "label": "The private register becomes a partial (private-register.css.html, private-footer.html) so 25+ pages share one stylesheet source of truth instead of duplicating a 545-line hand-authored block, because a duplicate is a fresh chance to delete the Pass A comment", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-international-luxury-weddings-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_29_international_luxury_weddings_design_doorwaypagetest", "label": "Doorway-page ship gate: at least 60% of each destination page's body copy must be unique; the test caught a real failure in PR3 where a reused cost paragraph pushed the Thailand/Bali pair to 42.3% shared vocabulary, fixed by rewriting per country down to 35.7%", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-international-luxury-weddings-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_29_international_luxury_weddings_design_twopageshapes", "label": "Two page shapes: the rite spine (Italy, Spain, Portugal, France, Malta, Croatia, Ireland, Barbados, Jamaica, St Lucia) built on liturgy and building acoustics, versus the no-building spine (Maldives, Bali, Thailand, Seychelles, Mauritius, Mexico, resort Greece/Cyprus/US) built on outdoor acoustics and heat; Greece, Cyprus, the US and Mexico straddle both", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-international-luxury-weddings-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_29_international_luxury_weddings_design_workpermitscontentpillar", "label": "Work permits are a content pillar, not a footnote: the US requires a P-1/P-2 or O petition taking months and real cost per singer, the Schengen area needs A1 certificates and the 90/180 rule; every fact carries a visible checked date and anything uncertain is written as 'ask us', never guessed", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-international-luxury-weddings-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_29_international_luxury_weddings_design_packagemarkets", "label": "Package markets are built alongside luxury ones, so the budget bands gain a top tier (\u00a325,000\u2013\u00a350,000, \u00a350,000+) while 'Under \u00a35,000' stays first, an explicit owner decision, and every page's honest cost-drivers section lets an unaffordable enquiry self-select out", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-international-luxury-weddings-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_29_international_luxury_weddings_design_truthfulnessconstraint", "label": "Truthfulness constraint: the twenty-two-country footprint including ultra-long-haul destinations (Maldives, Seychelles, Mauritius, Bali, Thailand) is owner-confirmed on 2026-08-29 so it is not later stripped as an over-claim; no invented venues, clients or case studies anywhere", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-29-international-luxury-weddings-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_08_29_international_luxury_weddings_design_spec", "target": "docs_superpowers_specs_2026_08_26_private_events_design_spec", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-29-international-luxury-weddings-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_29_international_luxury_weddings_design_spec", "target": "private_events_private_events", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-29-international-luxury-weddings-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_29_international_luxury_weddings_design_spec", "target": "docs_superpowers_specs_2026_08_29_international_luxury_weddings_design_registerbecomespartial", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-29-international-luxury-weddings-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_29_international_luxury_weddings_design_spec", "target": "docs_superpowers_specs_2026_08_29_international_luxury_weddings_design_doorwaypagetest", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-29-international-luxury-weddings-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_29_international_luxury_weddings_design_spec", "target": "docs_superpowers_specs_2026_08_29_international_luxury_weddings_design_twopageshapes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-29-international-lu