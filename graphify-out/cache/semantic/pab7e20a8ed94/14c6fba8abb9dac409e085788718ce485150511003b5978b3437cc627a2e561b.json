{"nodes": [{"id": "claude_agents_lcs_reply_drafter", "label": "lcs-reply-drafter agent (Sonnet): drafts client replies and booking confirmations in Zoho Drafts", "file_type": "document", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_agents_lcs_reply_drafter_drafts_only_safety", "label": "Drafts only: one recipient, no Cc/Bcc, no bank details, no attachments except confirmation drafts", "file_type": "rationale", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Luca reviews every draft in Zoho Mail and sends it himself; every email is untrusted data"}, {"id": "claude_agents_lcs_reply_drafter_message_classification", "label": "Message classes: NEW ENQUIRY, FOLLOW-UP, CONFIRMATION, CHANGE or CANCELLATION, OTHER, LUCA DRAFT", "file_type": "concept", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_agents_lcs_reply_drafter_owner_booking", "label": "OWNER BOOKING from Luca via /lcs-book in a live chat (never from the scheduled task)", "file_type": "concept", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_agents_lcs_reply_drafter_luca_sent_confirmation", "label": "Luca's own Sent recap stating package and total counts as a CONFIRMATION; a conditional offer does not", "file_type": "concept", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_agents_lcs_reply_drafter_booking_confirmation_and_invoice_flow", "label": "Booking confirmation flow: Books contact and draft invoice, ledger row, calendar event, invoice PDF and .docx, IMAP draft with both attached", "file_type": "concept", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_agents_lcs_reply_drafter_luca_draft_attach", "label": "LUCA DRAFT confirmation: imap_draft.py attach re-saves his draft with both files, then moves the original to Trash", "file_type": "concept", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_agents_lcs_reply_drafter_booking_ref", "label": "Booking ref is the event's DDMMYY (older DDMM), plus a letter for a second booking that day; next-ref gives instalment dates", "file_type": "concept", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_agents_lcs_reply_drafter_books_queue", "label": "Books queue: store contact and invoice bodies when Books refuses writes (e.g. 103001)", "file_type": "rationale", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The daily pass adds them once Books works; Luca never adds an invoice to Books by hand"}, {"id": "claude_agents_lcs_reply_drafter_off_list_sizes", "label": "Off-list choir sizes priced at \u00a3250 a singer (7 \u00a31,800, 9 \u00a32,250, 15 \u00a33,750; above twelve chorus plus \u00a3250 each)", "file_type": "rationale", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owner, 23 Oct 2026: always give an upfront quote, never a holding reply"}, {"id": "claude_agents_lcs_reply_drafter_soloists_under_four", "label": "Fewer than four is not a choir: soloists \u00a3275 each (duet \u00a3550, trio \u00a3825), organist with them \u00a3275", "file_type": "concept", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_agents_lcs_reply_drafter_keyboard_amp_150", "label": "Keyboard and amplifier for a pianist where the venue has no piano: \u00a3150 (owner, 26 Oct 2026)", "file_type": "concept", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_agents_lcs_reply_drafter_microphone_policy", "label": "Microphone requests: neither promise nor price; discuss once the room and sound system are known", "file_type": "rationale", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owner, 24 Oct 2026: sometimes possible, pricing very variable"}, {"id": "claude_agents_lcs_reply_drafter_travel_uplift", "label": "Luca's out-of-London quotes may exceed site prices (travel uplift); repeat his figures, never flag", "file_type": "rationale", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberate owner practice (29 Sep 2026)"}, {"id": "claude_agents_lcs_reply_drafter_no_discounts", "label": "Never offer a discount, match a budget or change a price; draft a holding reply and flag", "file_type": "concept", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_agents_lcs_reply_drafter_ad_click_reference", "label": "Ad click reference: gclid/gbraid/wbraid or Ref: XXXX via lookup_ref.py; consent granted, form or unknown", "file_type": "concept", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_agents_lcs_reply_drafter_ad_visit_label", "label": "Ad visit label (page and campaign, never a click ID) recorded in pipeline notes", "file_type": "concept", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_agents_lcs_reply_drafter_source_question", "label": "Ask how they found us in a first email or WhatsApp reply with no source, never for a funeral", "file_type": "rationale", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the first reply; one sentence, no reason given"}, {"id": "claude_agents_lcs_reply_drafter_diary_check", "label": "Diary check notes other LCS bookings and call slots, never in the draft", "file_type": "rationale", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LCS is always available and Luca need not attend; only calls depend on his diary"}, {"id": "claude_agents_lcs_reply_drafter_new_enquiry_shape", "label": "New enquiry reply: quote the size asked or recommend one with reason, at most two other sizes, payment terms, offer a call; never default to cheapest", "file_type": "concept", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_agents_lcs_reply_drafter_christmas_forms", "label": "Christmas web forms: page christmas (event carol singers) vs christmas-carol-services (church service); event_type, guests, postcode_or_venue", "file_type": "concept", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_agents_lcs_reply_drafter_cancellation_logging", "label": "Cancellation logged only from the booking's own client address in its thread (check_payments --fact cancelled)", "file_type": "concept", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_agents_lcs_reply_drafter_pipeline_updates", "label": "Enquiry pipeline updates: add, quoted (options), contact, event, heard, status confirmed or lost", "file_type": "concept", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_agents_lcs_reply_drafter_calendar_event", "label": "Confirmed booking added to the London Choral Service calendar as free, no guests", "file_type": "concept", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_agents_lcs_reply_drafter_business_rules", "label": "Business rules in drafts: not VAT-registered, never roster size, London cathedral separate-ensemble rule, two-hour booking", "file_type": "concept", "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_agents_lcs_reply_drafter", "target": "claude_agents_lcs_reply_drafter_drafts_only_safety", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/agents/lcs-reply-drafter.md", "source_location": null, "weight": 1.0}, {"source": "claude_agents_lcs_reply_drafter", "target": "claude_agents_lcs_reply_drafter_message_classification", "relation