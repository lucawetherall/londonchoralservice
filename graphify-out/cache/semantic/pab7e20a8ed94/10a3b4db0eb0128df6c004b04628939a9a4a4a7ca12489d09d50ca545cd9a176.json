{"nodes": [{"id": "music_guides_christmas_drinks_reception_music_page", "label": "Christmas Drinks Reception Music | London Choral Service", "file_type": "document", "source_file": "music-guides/christmas-drinks-reception-music.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_drinks_reception_music", "label": "Roaming or stationary carol sets at a drinks reception", "file_type": "concept", "source_file": "music-guides/christmas-drinks-reception-music.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "music_guides_christmas_drinks_reception_music_start_fifteen_minutes_early", "label": "Start singing fifteen minutes before guests arrive; stop before the room does", "file_type": "rationale", "source_file": "music-guides/christmas-drinks-reception-music.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most of the effect is in the first fifteen minutes; early arrivals are often the most senior guests."}, {"id": "music_guides_christmas_drinks_reception_music_distance_controls_volume", "label": "Distance is the volume control: edge of room, staircase or gallery, not mid-floor", "file_type": "rationale", "source_file": "music-guides/christmas-drinks-reception-music.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "music_guides_christmas_drinks_reception_music_reception_repertoire_close_harmony", "label": "Reception repertoire: close-harmony songs over carols; no Howells or Darke", "file_type": "rationale", "source_file": "music-guides/christmas-drinks-reception-music.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A talking room is not set up for congregational singing, and quiet choral pieces are written for a sil