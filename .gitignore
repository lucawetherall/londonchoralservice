.superpowers/
.DS_Store
.claude/.DS_Store
__pycache__/
graphify-out/.graphify_python
graphify-out/.graphify_root
# graphify scratch and caches that are cheap to rebuild or machine-local. The semantic
# cache (graphify-out/cache/semantic/) stays committed: it holds the LLM extraction.
graphify-out/.graphify_*.json
!graphify-out/.graphify_labels.json
graphify-out/.graphify_*.txt
graphify-out/.graphify_*.lock
graphify-out/cache/ast/
graphify-out/cache/stat-index.json
graphify-out/cache/last_query_stamp
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
# scripts/graph_concepts.py's stripped pages and agent prompts.
graphify-out/.graphify_text/
graphify-out/.graphify_prompt_*.md
# Query notes from graphify's save-result/reflect loop: not used here (they would land in content PRs).
graphify-out/memory/
graphify-out/reflections/
graphify-out/.vocab.txt
graphify-out/.needs_update

# Google Ads / GA4 workspace — never commit credentials
.venv
client_secret*.json
google-ads.yaml
*.local.*

# Private bookings ledger (client data) — lives in ~/lcs-private/, never in the repo
bookings*.csv
events*.jsonl
lcs-private/
.claude-ads/
