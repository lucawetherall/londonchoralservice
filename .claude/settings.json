  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -e \"$CLAUDE_PROJECT_DIR/.venv\" ] || { m=$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) && [ -d \"${m%/.git}/.venv\" ] && ln -s \"${m%/.git}/.venv\" \"$CLAUDE_PROJECT_DIR/.venv\"; }; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/mcp_bypass_guard.py\" || exit 2",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/owner_confirm_guard.py\" || exit 2",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/mcp_bypass_guard.py\" || exit 2",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|NotebookRead",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/mcp_bypass_guard.py\" || exit 2",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__terminal__run_in_terminal|mcp__Control_your_Mac__osascript|mcp__plugin_playwright_playwright__browser_run_code_unsafe",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/mcp_bypass_guard.py\" || exit 2",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__zoho-mail__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/zoho_guard.py\" || exit 2",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__zoho-books.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/zoho_books_guard.py\" || exit 2",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__caefd5da-81a5-4eb0-993a-dfeaa5b9d7c1__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/calendar_guard.py\" || exit 2",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
